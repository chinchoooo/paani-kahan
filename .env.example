# Copy to .env to override. All optional.
MODEL_PROVIDER=ollama            # or: anthropic
OLLAMA_MODEL=llama3.2:3b         # any Ollama model. With tool calling (llama3.2, qwen2.5) the agent picks its tools;
                                 # without it (llama3, phi3) the app runs the tools and the agent writes the advice
# AGENT_TIMEOUT_S=60             # raise to 120 for an 8B model on CPU
# OLLAMA_HOST=http://host.docker.internal:11434
# ANTHROPIC_API_KEY=sk-ant-...
# RAIN_SOURCE=live               # live (Open-Meteo), demo (elevated storm), replay:michaung2023 ... Switchable in the app.
# DEFAULT_ORIGIN=12.979,80.223   # where the map opens before your location is known (Velachery)
# DETAIL_KM=10                   # every street is loaded within this distance of you
# REGION_KM=100                  # main roads + terrain are loaded within this distance of you
# CPU_WORKERS=3                  # flood-model threads
# DATA_SOURCE=osm                # osm (real) or synthetic (invented streets, works offline)
# LIVE_REFRESH_MIN=15            # how often live mode re-fetches rain
# TOMTOM_API_KEY=...             # free key from developer.tomtom.com: live road closures, flooding and roadworks
# PHONE_LAN_URL=http://192.168.1.20:8081   # printed by scripts/phone-lan.ps1; shows a QR in the app
