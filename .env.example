# Copy to .env to override. All optional.
MODEL_PROVIDER=ollama            # or: anthropic
OLLAMA_MODEL=llama3.2:3b         # any Ollama model with tool calling (llama3.2, qwen2.5, ...)
# OLLAMA_HOST=http://host.docker.internal:11434
# ANTHROPIC_API_KEY=sk-ant-...
# AREA=velachery                 # data/<AREA>; default: velachery if fetched, else sample
# RAIN_SOURCE=live               # live (Open-Meteo) or demo (scripted storm). Switchable in the app.
# LIVE_REFRESH_MIN=15            # how often live mode re-fetches the rain forecast
# TOMTOM_API_KEY=...             # free key from developer.tomtom.com: live road closures, flooding and roadworks
